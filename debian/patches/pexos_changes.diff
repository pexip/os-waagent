+import inspect
+from unittest import TestCase
+
+from azurelinuxagent.common.osutil.default import DefaultOSUtil
+from azurelinuxagent.common.osutil.pexos import PexOSUtil
+
+
+class PexOSUtilTest(TestCase):
+
+    @staticmethod
+    def _gather_public_methods(obj: object) -> set[str]:
+        return {k for k, _ in inspect.getmembers(obj, inspect.isfunction) if not k.startswith("_")}
+
+    def test_all_default_methods_present(self) -> None:
+        """test that all DefaultOSUtil methods are implemented by PexOSUtil"""
+        # methods internal to the DefaultOSUtil
+        internal_methods = {
+            'is_selinux_enforcing',
+            'get_first_if',
+            'search_for_resource_disk',
+            'get_if_mac',
+            'get_mount_point',
+            'umount',
+            'restart_if',
+            'set_selinux_context',
+            'device_for_ide_port',
+            'get_endpoint_from_leases_path',
+            'check_and_recover_nic_state',
+            'unregister_agent_service',
+            'set_hostname_record',
+            'is_selinux_system',
+            'openssl_to_openssh',
+            'is_sys_user',
+            'set_block_device_timeout',
+            'is_loopback',
+            'get_primary_interface',
+            'restore_rules_files',
+            'mount',
+            'load_atapiix_mod',
+            'get_userentry',
+            'is_atapiix_mod_loaded',
+            'is_primary_interface',
+            'get_dvd_device',
+            'get_instance_id',
+            'is_current_instance_id',
+            'gen_password_hash',
+        }
+        self.assertSetEqual(
+            self._gather_public_methods(PexOSUtil) | internal_methods,
+            self._gather_public_methods(DefaultOSUtil)
+        )
