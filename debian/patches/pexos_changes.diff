+
+        # fall back to -c
+        if err_code != 0:
+            logger.info(
+                "sfdisk with --part-type failed [{0}], retrying with -c",
+                err_code)
+            command_to_use = '-c'
+            input = "sfdisk {0} {1} {2}".format(
